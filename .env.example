# ============================================
# 苏福万家智能客服 - 生产环境配置
# 复制此文件为 .env 并填入真实值
# ============================================

# 数据库配置
POSTGRES_DB=support_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请修改为强密码

# 阿里云 DashScope API Key（必填）
# 在 https://dashscope.console.aliyun.com/ 创建
DASHSCOPE_API_KEY=your-dashscope-api-key

# AI模型配置
# 对话模型：qwen-max（兼容性最好）、qwen3.7-max、qwen-plus、qwen-turbo
DASHSCOPE_MODEL=qwen-max
# 向量模型：qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding

# RAG 知识库开关
RAG_ENABLED=true

# 服务器配置
SERVER_PORT=8080

# 前端API基础地址（用于admin前端，H5使用相对路径）
# VITE_API_BASE_URL=https://your-domain.com
